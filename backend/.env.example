# Backend Environment Variables
# Copy this to .env and fill with actual values (NEVER commit .env to git)

# OpenRouter API Key for AI-powered code analysis
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=codetwin
DATABASE_URL=postgresql://postgres:password@localhost/codetwin

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Settings
PROJECT_NAME=CodeTwin
VERSION=0.2.0
API_V1_STR=/api/v1
